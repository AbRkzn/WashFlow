# Copy to .env.local and fill in. Never commit .env.local.
# Project Settings -> API / Keys in the Supabase dashboard.

# Public, safe to ship in the app bundle.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=YOUR-ANON-PUBLIC-KEY

# Expo project ID for remote push tokens (FCM via Expo push service).
# Project dashboard -> project ID, or leave blank to fall back to
# app.json extra.eas.projectId when using EAS.
EXPO_PUBLIC_EXPO_PROJECT_ID=YOUR-EXPO-PROJECT-ID

# Used ONLY by the Supabase CLI / Edge Function local runs.
# Not read by the app bundle. Copy from Project Settings -> Service Role.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
